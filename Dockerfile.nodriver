# Serviciu de extindere "+90 min" bazat pe nodriver (bypass Cloudflare/Turnstile).
# Pe Render (Docker, root) trebuie sandbox=False + --no-sandbox la Chromium.
# Turnstile-ul se comporta diferit in headful, asa ca rulam pe display virtual
# (xvfb) cu NODRIVER_HEADLESS=false.
FROM python:3.12-slim-bookworm

WORKDIR /app

# Chromium din repo Debian + dependinte grafice minime + xvfb (virtual display)
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    xvfb \
    xauth \
    fonts-liberation \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcups2 \
    libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 \
    libxrandr2 xdg-utils wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir nodriver

ENV NODRIVER_HEADLESS=false \
    NODRIVER_BROWSER_PATH=/usr/bin/chromium \
    PYTHONUNBUFFERED=1

COPY nodriver-extend.py .

# Pornim Xvfb manual + setam DISPLAY (xvfb-run se blocheaza ca PID 1 in Docker),
# apoi rulam scriptul in headful — Turnstile se comporta diferit fata de headless.
CMD ["bash", "-c", "Xvfb :99 -screen 0 1280x1024x24 & sleep 2; export DISPLAY=:99; python nodriver-extend.py"]