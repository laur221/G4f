# ─── URL-ul consolei serverului tau (din bara de adrese) ───
SERVER_CONSOLE_URL=https://control.gaming4free.net/server/48709f0f/console

# ─── Secret pentru semnarea sesiunii de login a prietenului tau ───
# Genereaza unul random, ex: openssl rand -hex 32
SESSION_SECRET=schimba-asta-cu-ceva-lung-si-random

# ─── Upstash Redis (creezi gratuit un database pe upstash.com) ───
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# ─── Portul pe care asculta serverul (Render il seteaza automat) ───
PORT=3000

# ─── Link-ul public al serviciului de pe Render, pt self-ping anti-sleep ───
# Exemplu: https://g4f-relay.onrender.com
PUBLIC_URL=

# ─── Sesiunea Google, encodata base64 (NUMAI pe Render, NU si local) ───
# Se genereaza local din storageState.json dupa "npm run capture-session":
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("storageState.json"))
# Necesar doar daca serverul nu are disc persistent / Shell (ex. Render Free).
STORAGE_STATE_B64=

# ═══════════════════════════════════════════════════════════════════════
#  Backup save Palworld -> Google Drive (rclone)
# ═══════════════════════════════════════════════════════════════════════
# Cum se configureaza rclone (o singura data, local):
#   rclone config create gdrive drive config_is_local=true
#   (te loghezi in browser cu contul Google)
# Apoi pune continutul rclone.conf (creat in folderul curent) in base64:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("rclone.conf"))
# si pastreaza-l aici:
RCLONE_CONF_B64=
# Remote-ul rclone si folderul de backup in Drive (creezi folderul cu:
#   rclone mkdir gdrive:g4f-palworld-backups )
GDRIVE_REMOTE=gdrive
GDRIVE_BACKUP_FOLDER=g4f-palworld-backups
# La fiecare cate minute ruleaza backup-ul (0 = dezactivat, doar manual
# prin POST /api/backup). Default: 180 (3 ore).
BACKUP_INTERVAL_MINUTES=180
# Cate backup-uri pastram pe Drive (cele vechi se sterg automat ca sa nu
# umplem locul). 0 = pastreaza toate. Default: 1.
BACKUP_KEEP_COUNT=1
# Directorul unde se salveaza save-ul in panoul de fisiere G4F.
# Trebuie sa arate ca un link din:  Files > Pal > Saved > SaveGames > 0 > <WORLDID>
G4F_SAVE_PATH=Pal/Saved/SaveGames/0/20C6479BE3F944D2BEC73FEF41CDA733

# ═══════════════════════════════════════════════════════════════════════
#  Serviciul worker "g4f-nodriver-extender" (nodriver += bypass Turnstile)
#  Ruleaza pe Render ca serviciu separat (vezi Dockerfile.nodriver).
# ═══════════════════════════════════════════════════════════════════════
NODRIVER_HEADLESS=true
NODRIVER_BROWSER_PATH=/usr/bin/chromium
# Timpul pana la care ridicam (accepta si "H:MM" / "H:MM:SS")
TARGET_SECONDS=12:00:00
# Pragul de pornire: cand timpul scade sub asta, incepe apasarea
BACKUP_SECONDS=02:00:00
# Cat de des verificam timpul (secunde)
CHECK_INTERVAL_SEC=60
# Pauza intre apasari (cooldown buton, 5 min)
COOLDOWN_SEC=300
ONESHOT=false
# ═══════════════════════════════════════════════════════════════════════
#  Bypass Turnstile (NU mai e necesar — Calea 0 e gratuita si suficienta)
# ═══════════════════════════════════════════════════════════════════════
# Calea 0 (primul pas in extindere): apel direct $wire.extendWebAd() prin
# Livewire. Confirmat empiric (aug 2026): serverul NU valideaza vizionarea
# reclamei — adauga +90 min direct, fara captcha si fara cheie API.
# CAPTCHA_API_KEY e doar FALLBACK (calea B) daca Calea 0 ar esua vreodata.
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha
