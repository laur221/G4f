# ─── URL-ul consolei serverului tau (din bara de adrese) ───
SERVER_CONSOLE_URL=https://control.gaming4free.net/server/48709f0f/console

# ─── Secret pentru semnarea sesiunii de login a prietenului tau ───
# Genereaza unul random, ex: openssl rand -hex 32
SESSION_SECRET=schimba-asta-cu-ceva-lung-si-random

# ─── Upstash Redis (creezi gratuit un database pe upstash.com) ───
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# ─── Portul pe care asculta serverul (Render il seteaza automat) ───
PORT=3000

# ─── Link-ul public al serviciului de pe Render, pt self-ping anti-sleep ───
# Exemplu: https://g4f-relay.onrender.com
PUBLIC_URL=

# ─── Sesiunea Google, encodata base64 (NUMAI pe Render, NU si local) ───
# Se genereaza local din storageState.json dupa "npm run capture-session":
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("storageState.json"))
# Necesar doar daca serverul nu are disc persistent / Shell (ex. Render Free).
STORAGE_STATE_B64=

# ═══════════════════════════════════════════════════════════════════════
#  Serviciul worker "g4f-nodriver-extender" (nodriver += bypass Turnstile)
#  Ruleaza pe Render ca serviciu separat (vezi Dockerfile.nodriver).
# ═══════════════════════════════════════════════════════════════════════
NODRIVER_HEADLESS=true
NODRIVER_BROWSER_PATH=/usr/bin/chromium
# Timpul pana la care ridicam (accepta si "H:MM" / "H:MM:SS")
TARGET_SECONDS=12:00:00
# Pragul de pornire: cand timpul scade sub asta, incepe apasarea
BACKUP_SECONDS=02:00:00
# Cat de des verificam timpul (secunde)
CHECK_INTERVAL_SEC=60
# Pauza intre apasari (cooldown buton, 5 min)
COOLDOWN_SEC=300
ONESHOT=false
